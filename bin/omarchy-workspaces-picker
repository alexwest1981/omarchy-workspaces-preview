#!/usr/bin/env bash
# ==============================================================================
# omarchy-workspaces-picker (Modern TUI Pro Edition)
# Global fuzzy window & workspace switcher for Omarchy / Hyprland
#
# Part of the Omarchy Workspaces Preview Plugin
# https://github.com/alexwest1981/omarchy-workspaces-preview
# ==============================================================================

set -euo pipefail

# ------------------------------------------------------------------------------
# Helper Functions
# ------------------------------------------------------------------------------
get_active_monitor_name() {
  local mon_info
  mon_info=$(hyprctl monitors -j 2>/dev/null || echo "[]")
  local desc
  desc=$(echo "$mon_info" | jq -r '.[] | select(.focused == true) | (.description // .model // .name // "Screen")')
  echo "$desc"
}

find_free_workspace() {
  local occupied
  occupied=$(hyprctl workspaces -j 2>/dev/null | jq -r '.[].id' | sort -n)
  
  for i in {1..10}; do
    if ! echo "$occupied" | grep -qx "$i"; then
      echo "$i"
      return 0
    fi
  done
  
  local max_ws
  max_ws=$(echo "$occupied" | tail -n 1)
  [[ -z "$max_ws" || "$max_ws" -lt 1 ]] && max_ws=1
  echo "$((max_ws + 1))"
}

# ------------------------------------------------------------------------------
# 1. Preview Card Sub-renderer (invoked by fzf --preview)
# ------------------------------------------------------------------------------
if [[ "${1:-}" == "--preview-card" ]]; then
  shift
  address="${1:-}"
  ws_id="${2:-}"
  app_name="${3:-}"
  title="${4:-}"
  pid="${5:-}"
  size="${6:-}"
  floating="${7:-}"
  icon="${8:-}"
  ws_label="${9:-}"
  cur_screen="${10:-Screen}"
  next_free_ws="${11:-2}"
  new_ws_mode="${12:-OFF}"

  if [[ -z "$address" ]]; then
    echo ""
    echo -e "\033[90m  Select a window to inspect details...\033[0m"
    exit 0
  fi

  state_str=$([[ "$floating" == "true" ]] && echo -e "\033[1;33m󰉈 Floating\033[0m" || echo -e "\033[1;32m󰕰 Tiled\033[0m")

  echo ""
  echo -e " \033[1;36m╭──────────────────────────────────────────────────────────╮\033[0m"
  printf " \033[1;36m│\033[0m  \033[1;35m%s\033[0m  \033[1;37m%-48.48s\033[0m \033[1;36m│\033[0m\n" "$icon" "$app_name"
  echo -e " \033[1;36m├──────────────────────────────────────────────────────────┤\033[0m"
  printf " \033[1;36m│\033[0m  \033[38;5;111m🏷️  Title:\033[0m      \033[1;37m%-43.43s\033[0m \033[1;36m│\033[0m\n" "$title"
  printf " \033[1;36m│\033[0m  \033[38;5;111m🖥️  Location:\033[0m   \033[1;33m%-43.43s\033[0m \033[1;36m│\033[0m\n" "$ws_label"
  printf " \033[1;36m│\033[0m  \033[38;5;111m📺 Active Mon:\033[0m  \033[1;36m%-43.43s\033[0m \033[1;36m│\033[0m\n" "$cur_screen"
  printf " \033[1;36m│\033[0m  \033[38;5;111m✨ Free WS:\033[0m     \033[1;32mWorkspace %-33.33s\033[0m \033[1;36m│\033[0m\n" "$next_free_ws"
  printf " \033[1;36m│\033[0m  \033[38;5;111m🪟 State:\033[0m      %-52b \033[1;36m│\033[0m\n" "$state_str"
  printf " \033[1;36m│\033[0m  \033[38;5;111m📐 Geometry:\033[0m   \033[37m%-43.43s\033[0m \033[1;36m│\033[0m\n" "$size"
  printf " \033[1;36m│\033[0m  \033[38;5;111m🔢 PID / Hex:\033[0m  \033[90m%s (%s)\033[0m\n" "$pid" "$address"
  echo -e " \033[1;36m├──────────────────────────────────────────────────────────┤\033[0m"
  echo -e " \033[1;36m│\033[0m  \033[1;32m⚡ Quick Actions:\033[0m                                       \033[1;36m│\033[0m"
  if [[ "$new_ws_mode" == "ON" ]]; then
    printf " \033[1;36m│\033[0m  \033[33m• Enter    \033[0m ➜ \033[1;32mOpen in new WS %-2s on this monitor\033[0m     \033[1;36m│\033[0m\n" "$next_free_ws"
  else
    echo -e " \033[1;36m│\033[0m  \033[33m• Enter    \033[0m ➜ \033[37mJump to window & focus\033[0m                    \033[1;36m│\033[0m"
  fi
  printf " \033[1;36m│\033[0m  \033[33m• Ctrl + N \033[0m ➜ \033[36mOpen in new WS %-2s on this monitor\033[0m     \033[1;36m│\033[0m\n" "$next_free_ws"
  echo -e " \033[1;36m│\033[0m  \033[33m• Ctrl + K \033[0m ➜ \033[31mClose this window\033[0m                         \033[1;36m│\033[0m"
  echo -e " \033[1;36m│\033[0m  \033[33m• Ctrl + M \033[0m ➜ \033[35mMove to current workspace\033[0m                 \033[1;36m│\033[0m"
  echo -e " \033[1;36m╰──────────────────────────────────────────────────────────╯\033[0m"
  exit 0
fi

# Ensure PATH contains mise, uv, cargo, and local bins
export PATH="$HOME/.local/share/mise/installs/uv/latest/.mise-bins:$HOME/.local/share/mise/shims:$HOME/.local/bin:$HOME/.cargo/bin:/usr/local/bin:/usr/bin:$PATH"

# ------------------------------------------------------------------------------
# 2. Main Launcher (Visual Task Switcher / TUI Fallback)
# ------------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Launch Visual Task Switcher by default
if [[ "${1:-}" != "--tui" ]]; then
  UV_CMD="$(command -v uv || echo "$HOME/.local/share/mise/installs/uv/latest/.mise-bins/uv")"
  if [[ -x "$UV_CMD" && -f "$SCRIPT_DIR/omarchy-task-switcher.py" ]]; then
    exec "$UV_CMD" run --with PyQt6 python "$SCRIPT_DIR/omarchy-task-switcher.py" "$@"
  fi
else
  shift
fi

if [ ! -t 0 ]; then
  exec omarchy-launch-tui --app-id=TUI.float "$0" "$@"
fi

# Dependencies
command -v hyprctl >/dev/null 2>&1 || { echo "Error: hyprctl is required" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "Error: jq is required" >&2; exit 1; }
command -v fzf >/dev/null 2>&1 || { echo "Error: fzf is required" >&2; exit 1; }

# Configuration
CONFIG_DIR="$HOME/.config/omarchy"
CONFIG_FILE="$CONFIG_DIR/workspaces-picker.json"

mkdir -p "$CONFIG_DIR"
if [[ ! -f "$CONFIG_FILE" ]]; then
  echo '{"theme":"system","border":"rounded","size":"standard","open_in_new_ws":false}' > "$CONFIG_FILE"
fi

get_cfg() {
  local key="$1"
  local default="$2"
  local val
  val=$(jq -r ".$key // empty" "$CONFIG_FILE" 2>/dev/null || echo "")
  if [[ -z "$val" || "$val" == "null" ]]; then
    echo "$default"
  else
    echo "$val"
  fi
}

set_cfg() {
  local key="$1"
  local val="$2"
  local tmp
  tmp=$(jq --arg k "$key" --arg v "$val" '.[$k] = ($v | if . == "true" then true elif . == "false" then false else . end)' "$CONFIG_FILE")
  echo "$tmp" > "$CONFIG_FILE"
}

cycle_theme() {
  local current
  current=$(get_cfg "theme" "system")
  case "$current" in
    system) set_cfg "theme" "tokyo-night" ;;
    tokyo-night) set_cfg "theme" "catppuccin" ;;
    catppuccin) set_cfg "theme" "nord" ;;
    nord) set_cfg "theme" "gruvbox" ;;
    gruvbox) set_cfg "theme" "cyberpunk" ;;
    cyberpunk) set_cfg "theme" "monochrome" ;;
    *) set_cfg "theme" "system" ;;
  esac
}

cycle_border() {
  local current
  current=$(get_cfg "border" "rounded")
  case "$current" in
    rounded) set_cfg "border" "sharp" ;;
    sharp) set_cfg "border" "double" ;;
    double) set_cfg "border" "bold" ;;
    bold) set_cfg "border" "none" ;;
    *) set_cfg "border" "rounded" ;;
  esac
}

cycle_size() {
  local current
  current=$(get_cfg "size" "standard")
  case "$current" in
    standard) set_cfg "size" "compact" ;;
    compact) set_cfg "size" "spacious" ;;
    *) set_cfg "size" "standard" ;;
  esac
}

toggle_new_ws_mode() {
  local current
  current=$(get_cfg "open_in_new_ws" "false")
  if [[ "$current" == "true" ]]; then
    set_cfg "open_in_new_ws" "false"
  else
    set_cfg "open_in_new_ws" "true"
  fi
}

get_theme_colors() {
  local theme="$1"
  case "$theme" in
    system)
      local theme_name
      theme_name=$(omarchy-theme-current 2>/dev/null || echo "tokyo-night")
      local slug
      slug=$(echo "$theme_name" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
      local colors_file="/usr/share/omarchy/themes/$slug/colors.toml"
      local accent="#7aa2f7" bg="#1a1b26" fg="#a9b1d6" selection="#292e42" yellow="#e0af68" cyan="#7dcfff"
      if [[ -f "$colors_file" ]]; then
        accent=$(grep '^accent *=' "$colors_file" | head -1 | cut -d'"' -f2 || echo "$accent")
        bg=$(grep '^background *=' "$colors_file" | head -1 | cut -d'"' -f2 || echo "$bg")
        fg=$(grep '^foreground *=' "$colors_file" | head -1 | cut -d'"' -f2 || echo "$fg")
        selection=$(grep '^selection *=' "$colors_file" | head -1 | cut -d'"' -f2 || echo "$selection")
        yellow=$(grep '^yellow *=' "$colors_file" | head -1 | cut -d'"' -f2 || echo "$yellow")
        cyan=$(grep '^cyan *=' "$colors_file" | head -1 | cut -d'"' -f2 || echo "$cyan")
      fi
      echo "bg:$bg,fg:$fg,hl:$yellow,bg+:$selection,fg+:$fg,hl+:$yellow,border:$accent,prompt:$cyan,pointer:$accent,header:$accent,info:$cyan,footer:$accent,preview-border:$accent"
      ;;
    tokyo-night)
      echo "bg:#1a1b26,fg:#a9b1d6,hl:#e0af68,bg+:#292e42,fg+:#c0caf5,hl+:#e0af68,border:#7aa2f7,prompt:#7dcfff,pointer:#7aa2f7,header:#7aa2f7,info:#7dcfff,footer:#7aa2f7,preview-border:#7aa2f7"
      ;;
    catppuccin)
      echo "bg:#1e1e2e,fg:#cdd6f4,hl:#f9e2af,bg+:#313244,fg+:#cdd6f4,hl+:#f9e2af,border:#89b4fa,prompt:#89dceb,pointer:#f5c2e7,header:#cba6f7,info:#89dceb,footer:#89b4fa,preview-border:#89b4fa"
      ;;
    nord)
      echo "bg:#2e3440,fg:#eceff4,hl:#ebcb8b,bg+:#3b4252,fg+:#eceff4,hl+:#ebcb8b,border:#88c0d0,prompt:#81a1c1,pointer:#88c0d0,header:#88c0d0,info:#81a1c1,footer:#88c0d0,preview-border:#88c0d0"
      ;;
    gruvbox)
      echo "bg:#282828,fg:#ebdbb2,hl:#fabd2f,bg+:#3c3836,fg+:#ebdbb2,hl+:#fabd2f,border:#fe8019,prompt:#8ec07c,pointer:#fe8019,header:#fabd2f,info:#8ec07c,footer:#fe8019,preview-border:#fe8019"
      ;;
    cyberpunk)
      echo "bg:#000b1e,fg:#00ffff,hl:#ff0055,bg+:#0d1b2a,fg+:#00ffff,hl+:#ff0055,border:#ff007f,prompt:#00ff9f,pointer:#ff007f,header:#00ff9f,info:#00ff9f,footer:#ff007f,preview-border:#ff007f"
      ;;
    monochrome)
      echo "bg:#121212,fg:#ffffff,hl:#aaaaaa,bg+:#262626,fg+:#ffffff,hl+:#ffffff,border:#777777,prompt:#ffffff,pointer:#ffffff,header:#ffffff,info:#aaaaaa,footer:#777777,preview-border:#777777"
      ;;
    *)
      echo "border:blue,prompt:cyan,pointer:magenta,hl:yellow,hl+:yellow"
      ;;
  esac
}

format_theme_label() {
  case "$1" in
    system) echo "Based on System" ;;
    tokyo-night) echo "Tokyo Night" ;;
    catppuccin) echo "Catppuccin" ;;
    nord) echo "Nord" ;;
    gruvbox) echo "Gruvbox" ;;
    cyberpunk) echo "Cyberpunk" ;;
    monochrome) echo "Monochrome" ;;
    *) echo "$1" ;;
  esac
}

format_border_label() {
  case "$1" in
    rounded) echo "Rounded" ;;
    sharp) echo "Sharp" ;;
    double) echo "Double" ;;
    bold) echo "Bold" ;;
    none) echo "None" ;;
    *) echo "$1" ;;
  esac
}

format_size_label() {
  case "$1" in
    compact) echo "List Only" ;;
    standard) echo "Split View" ;;
    spacious) echo "Wide View" ;;
    *) echo "$1" ;;
  esac
}

get_icon() {
  case "${1,,}" in
    *ghostty*|*terminal*|*alacritty*|*kitty*|*foot*) echo "󰞷" ;;
    *brave*|*chrome*|*chromium*|*firefox*|*zen*|*browser*) echo "󰈹" ;;
    *discord*|*vesktop*) echo "󰙯" ;;
    *antigravity*|*code*|*cursor*|*nvim*|*vim*|*idea*|*editor*) echo "󰘐" ;;
    *obsidian*|*notes*) echo "󰎞" ;;
    *spotify*|*music*|*cliamp*) echo "󰓇" ;;
    *nautilus*|*thunar*|*files*) echo "" ;;
    *zoom*|*meet*) echo "" ;;
    *signal*|*telegram*|*whatsapp*|*slack*) echo "󰍡" ;;
    *godot*|*unity*|*unreal*) echo "" ;;
    *gimp*|*inkscape*|*blender*|*krita*) echo "" ;;
    *) echo "" ;;
  esac
}

query=""
SELF_SCRIPT="$(realpath "$0")"

while true; do
  THEME=$(get_cfg "theme" "system")
  BORDER=$(get_cfg "border" "rounded")
  SIZE=$(get_cfg "size" "standard")
  NEW_WS_MODE=$(get_cfg "open_in_new_ws" "false")

  COLOR_SPEC=$(get_theme_colors "$THEME")
  THEME_LBL=$(format_theme_label "$THEME")
  BORDER_LBL=$(format_border_label "$BORDER")
  SIZE_LBL=$(format_size_label "$SIZE")
  NEW_WS_LBL=$([[ "$NEW_WS_MODE" == "true" ]] && echo "ON" || echo "OFF")

  # Detect active screen and next free workspace
  CURRENT_SCREEN=$(get_active_monitor_name)
  NEXT_FREE_WS=$(find_free_workspace)

  # Size / Layout & Preview parameters
  case "$SIZE" in
    compact)
      MARGIN="0,0"
      PADDING="0"
      PREVIEW_OPT="--preview-window=hidden"
      ;;
    spacious)
      MARGIN="1,2"
      PADDING="1"
      PREVIEW_OPT="--preview-window=right,48%,border-left"
      ;;
    *)
      MARGIN="1,2"
      PADDING="1"
      PREVIEW_OPT="--preview-window=right,44%,border-left"
      ;;
  esac

  # Fetch open windows from Hyprland IPC
  clients_json=$(hyprctl clients -j 2>/dev/null || echo "[]")

  # Build formatted list grouped by workspace
  items=$(echo "$clients_json" | jq -r '
    .[]
    | select(.mapped == true and .hidden == false and .class != "TUI.float" and .initialClass != "TUI.float" and (.title | test("omarchy-workspaces-picker"; "i") | not))
    | [
        (.workspace.id | tostring),
        .class,
        .title,
        .address,
        (.pid | tostring),
        (if .size then (.size[0]|tostring) + " × " + (.size[1]|tostring) + " px" else "N/A" end),
        (.floating | tostring)
      ]
    | @tsv
  ' | while IFS=$'\t' read -r ws_id class title address pid size_str floating; do
      [[ -z "$address" ]] && continue
      
      icon="$(get_icon "$class")"
      app_clean=$(echo "$class" | sed -E 's/^com\.[^.]+\.//; s/^org\.[^.]+\.//; s/-Default$//; s/^brave-app\./App: /')
      
      if [[ "$ws_id" -lt 0 ]]; then
        ws_badge="[Special]"
        ws_label="Special Workspace"
      else
        ws_badge="[WS $ws_id]"
        ws_label="Workspace $ws_id"
      fi

      display_row=$(printf "%-8.8s  %s  %-16.16s │ %s" \
        "$ws_badge" "$icon" "$app_clean" "$title")

      printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
        "$display_row" "$address" "$ws_id" "$app_clean" "$title" "$pid" "$size_str" "$floating" "$icon" "$ws_label"
  done | sort -V -k1,1)

  if [[ -z "$items" ]]; then
    echo "No active windows available."
    exit 0
  fi

  FOOTER_TEXT=" 🎨 Theme (Ctrl+T): $THEME_LBL  │  🖼️ Border (Ctrl+B): $BORDER_LBL  │  📐 View (Ctrl+S): $SIZE_LBL  │  ✨ New WS (Ctrl+W): $NEW_WS_LBL  │  ❌ Close (Ctrl+K)"

  # Run fzf with expectation on shortcut keys & live inspector preview
  fzf_output=$(echo "$items" | fzf \
    --delimiter=$'\t' \
    --with-nth=1 \
    --prompt="  Search windows > " \
    --header="  Workspace & Window Switcher (Enter: Jump, Esc: Cancel)" \
    --footer="$FOOTER_TEXT" \
    --preview="$SELF_SCRIPT --preview-card {2} {3} {4} {5} {6} {7} {8} {9} {10} '$CURRENT_SCREEN' '$NEXT_FREE_WS' '$NEW_WS_LBL'" \
    $PREVIEW_OPT \
    --reverse \
    --cycle \
    --pointer="▎❯" \
    --marker="✔" \
    --border="$BORDER" \
    --margin="$MARGIN" \
    --padding="$PADDING" \
    --color="$COLOR_SPEC" \
    --query="$query" \
    --print-query \
    --expect=ctrl-t,alt-t,ctrl-b,alt-b,ctrl-s,alt-s,ctrl-w,alt-w,ctrl-k,ctrl-m,ctrl-n \
    --info=inline || true)

  if [[ -z "$fzf_output" ]]; then
    exit 0
  fi

  # Robust array parsing of fzf output
  mapfile -t fzf_lines <<< "$fzf_output"
  query="${fzf_lines[0]:-}"
  key="${fzf_lines[1]:-}"
  selected="${fzf_lines[2]:-}"

  # If key line contains tabs, lines[1] is actually the selected item (key was empty)
  if [[ "$key" == *$'\t'* ]]; then
    selected="$key"
    key=""
  fi

  case "$key" in
    ctrl-t|alt-t)
      cycle_theme
      continue
      ;;
    ctrl-b|alt-b)
      cycle_border
      continue
      ;;
    ctrl-s|alt-s)
      cycle_size
      continue
      ;;
    ctrl-w|alt-w)
      toggle_new_ws_mode
      continue
      ;;
    ctrl-k)
      # Instantly close selected window
      if [[ -n "$selected" ]]; then
        address=$(echo "$selected" | awk -F'\t' '{print $2}')
        if [[ -n "$address" ]]; then
          hyprctl dispatch "hl.dsp.window.close({ address = \"$address\" })" >/dev/null 2>&1 || true
        fi
      fi
      continue
      ;;
    ctrl-m)
      # Move selected window to current active workspace
      if [[ -n "$selected" ]]; then
        address=$(echo "$selected" | awk -F'\t' '{print $2}')
        active_ws=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty' || echo "1")
        if [[ -n "$address" && -n "$active_ws" ]]; then
          hyprctl dispatch "hl.dsp.window.move({ window = \"address:$address\", workspace = \"$active_ws\" })" >/dev/null 2>&1 || true
        fi
      fi
      continue
      ;;
    ctrl-n)
      # Direct action: Open window in a brand new free workspace on the active monitor
      if [[ -n "$selected" ]]; then
        address=$(echo "$selected" | awk -F'\t' '{print $2}')
        free_ws=$(find_free_workspace)
        if [[ -n "$address" && -n "$free_ws" ]]; then
          hyprctl dispatch "hl.dsp.window.move({ window = \"address:$address\", workspace = \"$free_ws\" })" >/dev/null 2>&1 || true
          hyprctl dispatch "hl.dsp.focus({ workspace = \"$free_ws\" })" >/dev/null 2>&1 || true
          hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 || true
        fi
      fi
      exit 0
      ;;
    "")
      # Enter was pressed on a selected window
      if [[ -n "$selected" ]]; then
        address=$(echo "$selected" | awk -F'\t' '{print $2}')
        orig_ws_id=$(echo "$selected" | awk -F'\t' '{print $3}')

        if [[ "$NEW_WS_MODE" == "true" ]]; then
          # Open in new free workspace on the active monitor
          free_ws=$(find_free_workspace)
          if [[ -n "$address" && -n "$free_ws" ]]; then
            hyprctl dispatch "hl.dsp.window.move({ window = \"address:$address\", workspace = \"$free_ws\" })" >/dev/null 2>&1 || true
            hyprctl dispatch "hl.dsp.focus({ workspace = \"$free_ws\" })" >/dev/null 2>&1 || true
            hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 || true
          fi
        else
          # Jump directly to window on its existing workspace
          if [[ -n "$orig_ws_id" && "$orig_ws_id" != "Special" ]]; then
            hyprctl dispatch "hl.dsp.focus({ workspace = \"$orig_ws_id\" })" >/dev/null 2>&1 || true
          fi
          if [[ -n "$address" ]]; then
            hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 || true
          fi
        fi
      fi
      exit 0
      ;;
    *)
      exit 0
      ;;
  esac
done
exit 0
